{
  "name": "@fringeworks/types",
  "version": "1.3.0",
  "private": true,
  "description": "A library some will find handy, offering TypeScript utility types and constants that enumerate the values of a type.",
  "keywords": [
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fringeworks-js/types.git"
  },
  "license": "MIT",
  "author": "Mitsuhiro Seino",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "module": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "pnpm build && npm publish ./dist",
    "test": "vitest",
    "tidy": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" --config ./prettier.tidy.config.ts"
  },
  "devDependencies": {
    "@fringeworks/dev": "^0.14.0",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.21.0"
}
